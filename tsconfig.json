{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"strict": true,
		"types": ["$app/types", "node", "bun"],
		"paths": {
			"#lib/*": ["./src/lib/*"]
		}
	},
	"include": [
		"src",
		"scripts",
		"tests",
		"vite.config.ts",
		"playwright.config.ts",
		"drizzle.config.ts"
	],
	"exclude": ["tests/fixtures"]
}
