{
	"name": "karaokedex",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint . --max-warnings 0",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"check:tokens": "bun scripts/check-tokens.ts",
		"import": "bun scripts/import.ts",
		"sources:check": "bun scripts/sources-check.ts",
		"sources:status": "bun scripts/sources-status.ts",
		"knip": "knip",
		"test": "bun test",
		"test:e2e": "playwright test",
		"verify": "bun run format:check && bun run lint && bun run check && bun run check:tokens && bun run knip && bun run test && bun run build"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@fontsource/dm-mono": "^5.3.0",
		"@fontsource/instrument-serif": "^5.3.0",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-vercel": "^7.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@types/bun": "^1.4.4",
		"@types/node": "^24",
		"acorn": "^8.19.0",
		"cn": "^0.5.0",
		"drizzle-kit": "^0.31.11",
		"drizzle-orm": "^0.45.4",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"knip": "^6.44.0",
		"pdf-lib": "^1.17.1",
		"phosphor-svelte": "^3.1.1",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"shadcn-svelte": "^1.7.2",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwind-variants": "^4.0.0",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"unpdf": "^2.1.0",
		"vite": "^8.3.0"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@tanstack/svelte-virtual": "^3.13.50",
		"@tanstack/table-core": "^9.3.1",
		"animejs": "^4.5.0",
		"minisearch": "^7.2.0",
		"zod": "^4.6.7"
	}
}
